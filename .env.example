# Web3Forms Access Key for in-browser contact form delivery
# Get your free access key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Firebase Realtime Database URL for the live visitor counter
# e.g. https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
